#!/usr/bin/env bash
#
# awesome-skills — manage the globally installed awesome_skills collection.
#
#   awesome-skills link        create or refresh the symlinks (idempotent)
#   awesome-skills update      pull the latest commit, then re-link
#   awesome-skills list        show the status of every skill in the repo
#   awesome-skills uninstall   remove the symlinks this tool created
#   awesome-skills brief      apply the humanism_talk brief rules to every session
#
# Every command is safe to run repeatedly: running it twice leaves the machine
# in the same state as running it once.
#
# Environment overrides:
#   AWESOME_SKILLS_HOME    where the clone lives (default: ~/.awesome-skills)
#   AWESOME_SKILLS_BRANCH  branch to track (default: main)
#   AWESOME_SKILLS_BIN     where the CLI symlink goes (default: ~/.local/bin)
#   CLAUDE_CONFIG_DIR      Claude Code config dir (default: ~/.claude)

set -euo pipefail

HOME_DIR="${AWESOME_SKILLS_HOME:-$HOME/.awesome-skills}"
BRANCH="${AWESOME_SKILLS_BRANCH:-main}"
BIN_DIR="${AWESOME_SKILLS_BIN:-$HOME/.local/bin}"
SRC_DIR="$HOME_DIR/.claude/skills"
DEST_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"

die() { printf 'awesome-skills: %s\n' "$*" >&2; exit 1; }

# True when $1 is a symlink whose target points inside the awesome_skills clone.
owned_link() {
  local path="$1" target
  [ -L "$path" ] || return 1
  target="$(readlink "$path")"
  case "$target" in
    "$HOME_DIR"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Print every directory under .claude/skills that actually holds a SKILL.md.
each_skill() {
  local dir
  [ -d "$SRC_DIR" ] || die "no skills found at $SRC_DIR — is $HOME_DIR a complete clone?"
  for dir in "$SRC_DIR"/*/; do
    [ -f "$dir/SKILL.md" ] || continue
    printf '%s\n' "${dir%/}"
  done
}

cmd_link() {
  local src name dest
  local -a linked=() skipped=()

  mkdir -p "$DEST_DIR"

  while IFS= read -r src; do
    name="$(basename "$src")"
    dest="$DEST_DIR/$name"

    if [ -L "$dest" ]; then
      # A symlink is ours to manage, whoever created it.
      ln -sfn "$src" "$dest"
      linked+=("$name")
    elif [ -e "$dest" ]; then
      # A real directory or file is the user's own work. Leave it alone.
      skipped+=("$name")
    else
      ln -s "$src" "$dest"
      linked+=("$name")
    fi
  done < <(each_skill)

  # A link we own whose target is gone means the skill was removed upstream.
  # Left in place it shows up as a broken skill, so prune it here.
  local entry target
  local -a pruned=()
  for entry in "$DEST_DIR"/*; do
    [ -L "$entry" ] || continue
    owned_link "$entry" || continue
    target="$(readlink "$entry")"
    if [ ! -d "$target" ]; then
      rm -f "$entry"
      pruned+=("$(basename "$entry")")
    fi
  done

  mkdir -p "$BIN_DIR"
  ln -sfn "$HOME_DIR/bin/awesome-skills" "$BIN_DIR/awesome-skills"

  printf '\nLinked %d skill(s) into %s\n' "${#linked[@]}" "$DEST_DIR"
  if [ "${#linked[@]}" -gt 0 ]; then
    printf '  %s\n' "${linked[@]}"
  fi

  if [ "${#pruned[@]}" -gt 0 ]; then
    printf '\nRemoved %d link(s) whose skill no longer exists in the repo:\n' "${#pruned[@]}"
    printf '  %s\n' "${pruned[@]}"
  fi

  if [ "${#skipped[@]}" -gt 0 ]; then
    printf '\nSkipped %d skill(s) — a real directory already exists at that name:\n' "${#skipped[@]}"
    printf '  %s\n' "${skipped[@]}"
    printf 'Rename or remove those directories and re-run "awesome-skills link" to take them over.\n'
  fi

  printf '\nInstalled the CLI at %s/awesome-skills\n' "$BIN_DIR"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
      printf '\n%s is not on your PATH. Add this line to ~/.zshrc, then open a new shell:\n\n' "$BIN_DIR"
      printf '  export PATH="%s:$PATH"\n' "$BIN_DIR"
      ;;
  esac

  printf '\nRestart Claude Code to pick up the new skills.\n'
}

cmd_update() {
  [ -d "$HOME_DIR/.git" ] || die "$HOME_DIR is not a git clone. Re-run install.sh."
  printf 'Updating %s ...\n' "$HOME_DIR"
  git -C "$HOME_DIR" fetch --quiet origin "$BRANCH"
  git -C "$HOME_DIR" checkout --quiet "$BRANCH"
  git -C "$HOME_DIR" merge --quiet --ff-only "origin/$BRANCH"
  cmd_link
}

cmd_list() {
  local src name dest status target
  printf '%-22s %s\n' "SKILL" "STATUS"
  while IFS= read -r src; do
    name="$(basename "$src")"
    dest="$DEST_DIR/$name"

    if owned_link "$dest"; then
      target="$(readlink "$dest")"
      if [ -f "$target/SKILL.md" ]; then
        status="linked"
      else
        status="broken (target missing)"
      fi
    elif [ -L "$dest" ]; then
      status="skipped (symlink elsewhere)"
    elif [ -e "$dest" ]; then
      status="skipped (real directory)"
    else
      status="not linked"
    fi

    printf '%-22s %s\n' "$name" "$status"
  done < <(each_skill)
}

cmd_uninstall() {
  local purge=0 entry
  local -a removed=()

  [ "${1:-}" = "--purge" ] && purge=1

  if [ -d "$DEST_DIR" ]; then
    for entry in "$DEST_DIR"/*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      if owned_link "$entry"; then
        rm -f "$entry"
        removed+=("$(basename "$entry")")
      fi
    done
  fi

  printf 'Removed %d symlink(s) from %s\n' "${#removed[@]}" "$DEST_DIR"
  if [ "${#removed[@]}" -gt 0 ]; then
    printf '  %s\n' "${removed[@]}"
  fi

  if owned_link "$BIN_DIR/awesome-skills"; then
    rm -f "$BIN_DIR/awesome-skills"
    printf 'Removed %s/awesome-skills\n' "$BIN_DIR"
  fi

  if [ "$purge" -eq 1 ]; then
    rm -rf "$HOME_DIR"
    printf 'Removed the clone at %s\n' "$HOME_DIR"
  else
    printf '\nThe clone at %s was left in place.\n' "$HOME_DIR"
    printf 'Run "awesome-skills uninstall --purge" (or "rm -rf %s") to delete it too.\n' "$HOME_DIR"
  fi
}

cmd_brief() {
  local action="${1:-status}"
  local settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
  local script="$HOME_DIR/hooks/inject-brief.sh"
  local tmp

  command -v jq >/dev/null 2>&1 || die "jq is required for this command but was not found in PATH."

  case "$action" in
    on)
      [ -f "$script" ] || die "hook script not found at $script. Run \"awesome-skills update\" first."
      [ -x "$script" ] || chmod +x "$script"
      mkdir -p "$(dirname "$settings")"
      [ -f "$settings" ] || printf '{}\n' > "$settings"

      tmp="$(mktemp)"
      jq --arg cmd "\"$script\"" '
        def strip(ev): (.hooks[ev] // [])
          | map(select(any(.hooks[]?; (.command // "") | contains("inject-brief.sh")) | not));
        def entry(ev; msg): {hooks: [{type: "command", command: ($cmd + " " + ev), timeout: 10, statusMessage: msg}]};
        .hooks = (.hooks // {})
        | .hooks.SessionStart = (strip("SessionStart") + [entry("SessionStart"; "humanism_talk brief 규칙 주입 중")])
        | .hooks.PostCompact  = (strip("PostCompact")  + [entry("PostCompact";  "humanism_talk brief 규칙 재주입 중")])
      ' "$settings" > "$tmp" && mv "$tmp" "$settings"

      printf 'brief mode is on. Registered SessionStart and PostCompact hooks in %s\n' "$settings"
      printf 'New Claude Code sessions will start with the humanism_talk brief rules applied.\n'
      printf '\nTo silence it in one project without unregistering, create <project>/.claude/humanism_talk.off\n'
      ;;
    off)
      [ -f "$settings" ] || { printf 'brief mode is already off (no %s)\n' "$settings"; return; }
      tmp="$(mktemp)"
      jq '
        if .hooks then
          .hooks |= (with_entries(.value |= map(select(any(.hooks[]?; (.command // "") | contains("inject-brief.sh")) | not)))
                     | with_entries(select(.value | length > 0)))
        else . end
      ' "$settings" > "$tmp" && mv "$tmp" "$settings"
      printf 'brief mode is off. Removed the hooks from %s\n' "$settings"
      ;;
    status)
      if [ -f "$settings" ] && jq -e '[.hooks // {} | .[]? | .[]? | .hooks[]? | select((.command // "") | contains("inject-brief.sh"))] | length > 0' "$settings" >/dev/null 2>&1; then
        printf 'brief mode: on   (hooks registered in %s)\n' "$settings"
      else
        printf 'brief mode: off  (no hooks in %s)\n' "$settings"
      fi
      if [ -f "$HOME/.claude/humanism_talk.off" ]; then
        printf 'note: ~/.claude/humanism_talk.off exists, so the hook exits early everywhere.\n'
      fi
      ;;
    *)
      die "unknown argument \"$action\". Use: awesome-skills brief [on|off|status]"
      ;;
  esac
}

usage() {
  cat <<'USAGE'
awesome-skills — manage the globally installed awesome_skills collection.

Usage:
  awesome-skills link                create or refresh the skill symlinks
  awesome-skills update              pull the latest commit, then re-link
  awesome-skills list                show the status of every skill
  awesome-skills uninstall [--purge] remove the symlinks; --purge also deletes the clone
  awesome-skills brief [on|off|status]
                                     turn the humanism_talk brief mode on for every session
USAGE
}

case "${1:-}" in
  link) cmd_link ;;
  update) cmd_update ;;
  list) cmd_list ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  brief) shift; cmd_brief "${1:-}" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
